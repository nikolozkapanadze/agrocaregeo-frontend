# API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Optional: Mapbox access token for high-resolution satellite basemap
# Get a free token at https://account.mapbox.com/access-tokens/
# Mapbox Satellite updates more frequently than Esri and is ideal for agriculture.
# VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Note on Google Maps Satellite:
# Google does not provide an official raster tile URL for Leaflet.
# To use Google Maps officially you need:
#   1. A Google Maps Platform API key
#   2. The npm package leaflet.gridlayer.googlemutant (or a custom wrapper)
# If you want Google Maps integration, install the plugin and wrap it
# in a React Leaflet component.
